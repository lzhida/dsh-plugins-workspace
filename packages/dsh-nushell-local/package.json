{
  "name": "@lzhida/dsh-nushell-local",
  "description": "Local Nushell shell executor for DeepSeek Harness — injects ctx.shell backed by ctx.subprocess",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@lzhida/dsh-tool-nushell": "workspace:*"
  },
  "peerDependencies": {
    "@lzhida/dsh-tool-nushell": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
