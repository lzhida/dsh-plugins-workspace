{
  "name": "@zhidal/dsh-patent",
  "description": "dsh-patent bundle 包：「专利交底」预设（发明人模式，中国专利）+ 交底书撰写工具行。预设默认携带 web 检索、Office(docx) 产出、权利要求结构校验 / 交底书模板填充 / 格式合规检查三个模型工具、结构化 prompt 段落与内嵌方法论 skill（patent-disclosure）。交付三路径：内置通用模板 docx（python-docx 填充保格式）/ 用户自带模板 docx / markdown 自填。",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "homepage": "https://github.com/lzhida/dsh-plugins-workspace/tree/main/packages/dsh-patent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzhida/dsh-plugins-workspace.git",
    "directory": "packages/dsh-patent"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --sourcemap",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
