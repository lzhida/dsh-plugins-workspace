{
  "name": "@lzhida/dsh-open-in-zed",
  "description": "用 Zed 编辑器打开工作区目录：Web GUI 会话菜单「用 Zed 打开」入口 + /dsh-open-in-zed 路由 + open_in_zed agent 工具。仅允许打开已注册工作区路径，Zed 未安装时返回可读指引。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:client": "tsdown -c tsdown.client.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "0.22.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions"
      ],
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
