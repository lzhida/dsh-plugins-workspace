{
  "name": "@lzhida/dsh-model-fallback",
  "description": "dsh-model-fallback 插件：拦截全局 LLM 调用，按 fallbackChains 在主模型失败时自动切换到下一个候选 provider/model，提供最大重试次数与可识别失败码配置；语义对齐 oh-my-pi 的 retry.modelFallback / retry.fallbackChains。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
