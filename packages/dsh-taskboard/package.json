{
  "name": "@lzhida/dsh-taskboard",
  "description": "Agent-first 任务看板插件：宿主权威任务台账 + 10 个 taskboard_* agent 工具、项目(=workspace)认领边界、按任务指定模型执行、可选 git worktree 隔离、宿主侧 cron 调度、SSE 实时看板。源码同步自 cloader/dsh-taskboard 0.8.7，经本 monorepo 规范重构，功能与上游一致。",
  "version": "0.8.8",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./invariant": "./src/invariant.ts",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:client": "tsdown -c tsdown.client.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "0.22.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
