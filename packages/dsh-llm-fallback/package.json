{
  "name": "@zhidal/dsh-llm-fallback",
  "description": "dsh-llm-fallback 插件：拦截全局 LLM 调用，会话指定的模型（事实主模型）失败时按 fallbackChains 纯回退队列自动切换到下一个候选 provider/model。retriesBeforeSwitch 控制每候选切换前的同 provider 重试次数（默认 0=跟随官方 dsh-llm-retry 预算；N>0=以插件为准，超出官方预算部分由插件代执行），对话不中断。",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/cordis.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "src/cordis.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "homepage": "https://github.com/lzhida/dsh-plugins-workspace/tree/main/packages/dsh-llm-fallback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzhida/dsh-plugins-workspace.git",
    "directory": "packages/dsh-llm-fallback"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --sourcemap",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
