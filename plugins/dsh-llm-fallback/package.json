{
  "name": "@zhidal/dsh-llm-fallback",
  "description": "dsh-llm-fallback 插件：拦截全局 LLM 调用，会话指定的模型（事实主模型）失败时按 fallbackChains 纯回退队列自动切换到下一个候选 provider/model；同候选重试预算固定跟随官方 dsh-llm-retry（provider 重试策略，默认 5），耗尽才切换；失败候选冷却支持配额感知/熔断递增/retry-after 对齐；支持候选级 reasoningEffort/maxTokens 覆盖；对话不中断。",
  "version": "0.6.0",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/cordis.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "src/cordis.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "homepage": "https://github.com/lzhida/dsh-plugins-workspace/tree/main/plugins/dsh-llm-fallback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzhida/dsh-plugins-workspace.git",
    "directory": "plugins/dsh-llm-fallback"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --sourcemap",
    "build:client": "node scripts/build-client.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
