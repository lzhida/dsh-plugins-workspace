{
  "name": "@zhidal/dsh-decision",
  "description": "dsh-decision 决策域组合包：把「需要人拍板的决策点」做成可插拔的门控插件，按 <决策点>-gate 命名。ask-gate 插件行注册与出厂 legacy 模式 schema 兼容的同名 ask_user_question 工具——总开关关闭时直通宿主 userQuestions 通道（行为与出厂完全一致），开启时先由决策模型评估置信度：达标则自动作答并落账 presentationMeta（置信度/判定/理由），不达标或任何降级（模型缺失/配置缺/调用失败/超时/解析失败）一律 fail-open 放行真实提问。",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/cordis.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ask-gate": "./src/entries/ask-gate.ts",
    "./decision-tools": "./src/entries/decision-tools.ts",
    "./tools": "./src/tools/index.ts",
    "./core": "./src/core/index.ts",
    "./client": "./client/dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.ts",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  }
}
